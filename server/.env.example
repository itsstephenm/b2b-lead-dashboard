# Copy this file to .env and fill in your values.
# All variables marked * are required.

# ── Database ──────────────────────────────────────────────────────────────────
# * PostgreSQL connection string (Supabase, Railway, Neon, etc.)
# Local:  DATABASE_URL=postgresql://user:password@localhost:5432/b2b_leads
# Hosted: DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Authentication ────────────────────────────────────────────────────────────
# * Single-admin credentials validated in POST /api/auth/login
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your-strong-password-here

# * Secret used to sign & verify JWTs. Use a long random string (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
